<?xml version="1.0"?>
<robot name="humanoid_upper_body" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find dexhandv2_description)/urdf/dexhandv2_right.xacro"/>
  
  <link name="world"/>

  <!-- Pelvis (Base of the upper body) -->
  <joint name="pelvis_joint" type="fixed">
    <parent link="world"/>
    <child link="pelvis"/>
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
  </joint>

  <link name="pelvis">
    <visual>
      <geometry>
        <box size="0.2 0.3 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Torso (Stomach to Chest) -->
  <joint name="waist_yaw" type="revolute">
    <parent link="pelvis"/>
    <child link="torso"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
  </joint>

  <link name="torso">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.3 0.4"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Neck & Head (3-DOF) -->
  <joint name="neck_yaw" type="revolute">
    <parent link="torso"/>
    <child link="neck_link_1"/>
    <origin xyz="0 0 0.45" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
  </joint>
  
  <link name="neck_link_1"/>

  <joint name="neck_pitch" type="revolute">
    <parent link="neck_link_1"/>
    <child link="neck_link_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.78" upper="0.78" effort="10" velocity="3"/>
  </joint>

  <link name="neck_link_2"/>

  <joint name="neck_roll" type="revolute">
    <parent link="neck_link_2"/>
    <child link="head"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.78" upper="0.78" effort="10" velocity="3"/>
  </joint>

  <link name="head">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
      <material name="skin">
        <color rgba="0.9 0.7 0.6 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Jaw -->
  <joint name="jaw_pitch" type="revolute">
    <parent link="head"/>
    <child link="jaw"/>
    <origin xyz="0 0.05 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.0" effort="10" velocity="3"/>
  </joint>

  <link name="jaw">
    <visual>
      <origin xyz="0 0.05 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.02"/>
      </geometry>
      <material name="skin"/>
    </visual>
  </link>

  <!-- Right Arm -->
  <!-- Right Shoulder Base -->
  <joint name="r_shoulder_yaw" type="revolute">
    <parent link="torso"/>
    <child link="r_shoulder_link"/>
    <origin xyz="0 -0.2 0.35" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
  </joint>

  <link name="r_shoulder_link">
    <visual>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="r_shoulder_pitch" type="revolute">
    <parent link="r_shoulder_link"/>
    <child link="r_bicep"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  
  <link name="r_bicep">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  
  <joint name="r_elbow_pitch" type="revolute">
    <parent link="r_bicep"/>
    <child link="r_forearm"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.5" effort="10" velocity="3"/>
  </joint>
  
  <link name="r_forearm">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  
  <!-- Right Wrist Connects to DexHand's base_link -->
  <joint name="r_wrist_roll" type="revolute">
    <parent link="r_forearm"/>
    <child link="base_link"/>
    <origin xyz="0 0 -0.3" rpy="1.5708 0 0"/> <!-- Rotate so hand faces forward -->
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
  </joint>

  <!-- Left Arm -->
  <!-- Left Shoulder Base -->
  <joint name="l_shoulder_yaw" type="revolute">
    <parent link="torso"/>
    <child link="l_shoulder_link"/>
    <origin xyz="0 0.2 0.35" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
  </joint>

  <link name="l_shoulder_link">
    <visual>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="l_shoulder_pitch" type="revolute">
    <parent link="l_shoulder_link"/>
    <child link="l_bicep"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  
  <link name="l_bicep">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  
  <joint name="l_elbow_pitch" type="revolute">
    <parent link="l_bicep"/>
    <child link="l_forearm"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.5" effort="10" velocity="3"/>
  </joint>
  
  <link name="l_forearm">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="l_wrist_roll" type="revolute">
    <parent link="l_forearm"/>
    <child link="l_dummy_hand"/>
    <origin xyz="0 0 -0.3" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
  </joint>

  <link name="l_dummy_hand">
    <visual>
      <geometry>
        <box size="0.05 0.1 0.15"/>
      </geometry>
      <material name="grey"/>
      <origin xyz="0 0.05 0" rpy="0 0 0"/>
    </visual>
  </link>

</robot>
