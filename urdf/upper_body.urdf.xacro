<?xml version="1.0"?>
<robot name="humanoid_arm" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find dexhandv2_description)/urdf/dexhandv2_right.xacro"/>
  
  <link name="world"/>
  
  <!-- Torso / Shoulder Base -->
  <joint name="shoulder_yaw" type="revolute">
    <parent link="world"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="shoulder_pitch" type="revolute">
    <parent link="shoulder_link"/>
    <child link="bicep"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  
  <link name="bicep">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.3"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
  </link>
  
  <joint name="elbow_pitch" type="revolute">
    <parent link="bicep"/>
    <child link="forearm"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.5" effort="10" velocity="3"/>
  </joint>
  
  <link name="forearm">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  
  <!-- Connects to the DexHand's base_link -->
  <joint name="wrist_roll" type="revolute">
    <parent link="forearm"/>
    <child link="base_link"/>
    <origin xyz="0 0 -0.3" rpy="1.5708 0 0"/> <!-- Rotate so hand faces forward -->
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
  </joint>



</robot>
